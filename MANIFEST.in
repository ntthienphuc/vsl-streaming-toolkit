include LICENSE.txt Licence.txt THIRD_PARTY_NOTICES.md CITATION.cff CHANGELOG.md CONTRIBUTING.md REPRODUCE.md
include requirements-tested.txt Dockerfile .dockerignore Start-Demo.ps1
recursive-include docs *.md
recursive-include examples *.py
recursive-include examples *.json
recursive-include third_party *.txt *.md
recursive-include clients/android *.md *.kts *.kt *.xml *.properties *.bat *.py gradlew gradle-wrapper.jar
prune clients/android/.gradle
prune clients/android/.kotlin
prune clients/android/app/build
prune clients/android/transport/build
prune clients/android/stream-client/build
prune clients/android/app/src/main/assets
exclude clients/android/local.properties
recursive-include tests *.py
recursive-include tools *.py
